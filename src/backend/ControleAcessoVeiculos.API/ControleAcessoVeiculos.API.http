@ControleAcessoVeiculos.API_HostAddress = http://localhost:5118
@Email = admin.local@example.test
@Password = replace-with-local-password
@AccessToken = replace-with-access-token

GET {{ControleAcessoVeiculos.API_HostAddress}}/health/ready
Accept: application/json

###

POST {{ControleAcessoVeiculos.API_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###

GET {{ControleAcessoVeiculos.API_HostAddress}}/weatherforecast
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{ControleAcessoVeiculos.API_HostAddress}}/users
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "name": "Pessoa Fictícia",
  "email": "pessoa.ficticia@example.test",
  "password": "replace-with-local-password",
  "profileName": "Porteiro"
}

###

POST {{ControleAcessoVeiculos.API_HostAddress}}/access-records/entries
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "driverName": "Condutor Fictício",
  "plate": "ABC-1D23",
  "objective": "Visita técnica",
  "categoryName": "Visitante",
  "vehicleType": "Automóvel",
  "color": "Prata"
}

###

GET {{ControleAcessoVeiculos.API_HostAddress}}/access-records/open
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

GET {{ControleAcessoVeiculos.API_HostAddress}}/access-records/history?plate=ABC-1D23&driverName=Condutor&categoryName=Visitante&status=Encerrado&from=2026-08-01T00:00:00Z&to=2026-08-31T23:59:59Z&page=1&pageSize=25
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{ControleAcessoVeiculos.API_HostAddress}}/access-records/1/exit
Authorization: Bearer {{AccessToken}}

###

PUT {{ControleAcessoVeiculos.API_HostAddress}}/access-records/1/correction
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "objective": "Entrega autorizada",
  "categoryName": "Entrega",
  "observation": "Conferido",
  "justification": "Categoria e objetivo conferidos pelo vigilante."
}

###

POST {{ControleAcessoVeiculos.API_HostAddress}}/institutional-vehicles
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "plate": "IFP-1E23",
  "identification": "FROTA-001",
  "vehicleType": "Automóvel",
  "brand": "Marca fictícia",
  "model": "Modelo de teste",
  "color": "Branco",
  "year": 2026
}

###

GET {{ControleAcessoVeiculos.API_HostAddress}}/institutional-vehicles
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

PUT {{ControleAcessoVeiculos.API_HostAddress}}/institutional-vehicles/1
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "plate": "IFP-1E23",
  "identification": "FROTA-001",
  "vehicleType": "Van",
  "brand": "Marca fictícia",
  "model": "Modelo de teste",
  "color": "Branco",
  "year": 2026
}

###

DELETE {{ControleAcessoVeiculos.API_HostAddress}}/institutional-vehicles/1
Authorization: Bearer {{AccessToken}}

###

POST {{ControleAcessoVeiculos.API_HostAddress}}/institutional-vehicles/1/reactivation
Authorization: Bearer {{AccessToken}}

###

POST {{ControleAcessoVeiculos.API_HostAddress}}/institutional-drivers
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "name": "Motorista Fictício",
  "documentType": "ID",
  "documentNumber": "EXEMPLO-001"
}

###

GET {{ControleAcessoVeiculos.API_HostAddress}}/institutional-drivers
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

DELETE {{ControleAcessoVeiculos.API_HostAddress}}/institutional-drivers/1
Authorization: Bearer {{AccessToken}}

###

POST {{ControleAcessoVeiculos.API_HostAddress}}/institutional-vehicle-usages/departures
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "vehicleId": 1,
  "driverId": 1,
  "departureMileage": 12500,
  "itinerary": "Campus - Unidade rural"
}

###

GET {{ControleAcessoVeiculos.API_HostAddress}}/institutional-vehicle-usages/open
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

GET {{ControleAcessoVeiculos.API_HostAddress}}/institutional-vehicle-usages/history?plate=IFP-1E23&from=2026-08-01T00:00:00Z&to=2026-08-31T23:59:59Z&page=1&pageSize=25
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

