{
  "Authentication": {
    "Jwt": {
      "Issuer": "ControleAcessoVeiculos.API",
      "Audience": "ControleAcessoVeiculos.Client",
      "ExpirationMinutes": 15
    }
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "LoginPermitLimit": 30,
    "LoginWindowSeconds": 60
  },
  "Institution": {
    "TimeZoneId": "America/Recife"
  },
  "Observability": {
    "Enabled": false,
    "ServiceName": "controle-acesso-veiculos-api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
