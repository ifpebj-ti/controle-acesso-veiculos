# A mesma versao publicada deve ser usada pelo frontend e pelo backend.
DEPLOYMENT_VERSION=0.4.0

# O frontend escuta apenas no loopback para ficar atras de um terminador HTTPS.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
# localhost e usado somente pela verificacao interna de saude do backend.
ALLOWED_HOSTS=acesso-veiculos.example.test;localhost

POSTGRES_DB=controle_acesso
POSTGRES_USER=controle_acesso_app
# Prefira um valor aleatorio hexadecimal ou base64url, sem delimitadores de connection string.
POSTGRES_PASSWORD=

# Gere pelo menos 32 bytes aleatorios e mantenha o valor fora do repositorio.
JWT_SIGNING_KEY=

# Certificado PFX fornecido por secret manager e volume durável compartilhado
# entre todas as réplicas autorizadas. Nunca armazene o PFX no repositório.
DATA_PROTECTION_CERTIFICATE_FILE=/opt/controle-acesso-veiculos/secrets/data-protection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD_FILE=/opt/controle-acesso-veiculos/secrets/data-protection-password.txt
DATA_PROTECTION_KEY_RING_VOLUME=controle-acesso-veiculos-data-protection

# Habilite somente quando existir um collector protegido e acessivel.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=controle-acesso-veiculos-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
