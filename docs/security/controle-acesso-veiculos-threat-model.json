                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-06 — Operador nega uma ação",
                  "type": "Repudiation",
                  "description": "O operador pode negar inclusão, correção ou encerramento se a evidência for insuficiente.",
                  "mitigation": "Associar usuário, horário, registro, justificativa e correlation ID; preservar auditoria transacional. Imutabilidade por infraestrutura ainda é pendente.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000006"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-18 — Operação persiste sem auditoria",
                  "type": "Repudiation",
                  "description": "Falha na auditoria pode deixar uma operação crítica sem trilha correspondente.",
                  "mitigation": "Persistir mudança e auditoria na mesma transação e falhar de forma fechada. Alertas e operações futuras ainda precisam de cobertura.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000018"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-19 — Collector OTLP não confiável",
                  "type": "Information disclosure",
                  "description": "Um collector falso ou mal configurado pode receber telemetria operacional.",
                  "mitigation": "Manter exportação desabilitada por padrão e exigir TLS, autenticação, menor privilégio e revisão de atributos na infraestrutura real.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000019"
                }
              ]
            }
