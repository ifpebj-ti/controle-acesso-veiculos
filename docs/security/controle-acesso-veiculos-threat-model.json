              "isSigned": false,
              "hasOpenThreats": true,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-04 — Alteração direta do histórico",
                  "type": "Tampering",
                  "description": "Acesso direto ao banco pode alterar ou remover registros operacionais.",
                  "mitigation": "Restringir rede e privilégios, preservar auditoria, backup e separação de contas. Controles definitivos de produção permanecem pendentes.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000004"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-10 — PostgreSQL exposto na rede",
                  "type": "Information disclosure",
                  "description": "Publicar o PostgreSQL em interface inadequada amplia acesso e tentativa de exploração.",
                  "mitigation": "Não publicar o banco em produção; usar rede privada, firewall, TLS e menor privilégio.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000010"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-16 — Retenção sem finalidade",
                  "type": "Information disclosure",
                  "description": "Dados pessoais e histórico mantidos indefinidamente aumentam exposição e podem contrariar a finalidade.",
                  "mitigation": "Aprovar política de retenção, descarte e anonimização com a instituição antes da produção — Issue #30.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000016"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-17 — Migration causa perda de dados",
                  "type": "Tampering",
                  "description": "Uma migration incorreta pode apagar ou transformar dados sem semântica confiável.",
                  "mitigation": "Revisar migrations, testar upgrade e downgrade, exigir backup restaurável e falhar explicitamente. Processo de produção pendente.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000017"
                }
              ]
            }
          },
