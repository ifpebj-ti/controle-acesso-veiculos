            "zIndex": 1,
            "data": {
              "name": "Usuário autorizado",
              "description": "Porteiro, Vigilante, Setor de Transporte ou Administrador, conforme a política da operação.",
              "type": "tm.Actor",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "providesAuthentication": false,
              "hasOpenThreats": true,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-01 — Conta compartilhada, inicial ou roubada",
                  "type": "Spoofing",
                  "description": "Uma conta compartilhada ou comprometida impede atribuir com confiança a operação ao responsável real.",
                  "mitigation": "Usar contas individuais, hash de senha, bloqueio temporário, troca autenticada com versão de credencial, credencial temporária de uso único e expiração curta, troca obrigatória, revogação transacional e auditoria. Canal de entrega, responsáveis institucionais e homologação permanecem pendentes nas Issues #162 e #220.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000001"
                }
              ]
            }
          },
