            "zIndex": 3,
            "data": {
              "name": "Frontend React e Nginx",
              "description": "Interface do MVP e proxy same-origin. A autorização efetiva permanece no servidor.",
              "type": "tm.Process",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-14 — Container executado com privilégios excessivos",
                  "type": "Elevation of privilege",
                  "description": "Uma exploração tem impacto maior se o processo do container possuir privilégios desnecessários.",
                  "mitigation": "Executar como usuário não privilegiado, restringir filesystem e capabilities e verificar a imagem na CI.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000014"
                },
                {
                  "status": "Mitigated",
                  "severity": "High",
                  "title": "TM-22 — Conteúdo indevido ou incorporação externa",
                  "type": "Tampering",
                  "description": "Conteúdo não autorizado pode ser carregado ou a aplicação pode ser incorporada por uma página externa.",
                  "mitigation": "CSP same-origin, bloqueio de frames, MIME sniffing desabilitado, política de referência, permissões mínimas e baseline DAST passiva no ambiente descartável. HTTPS e HSTS ainda dependem do ambiente institucional.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000022"
                }
              ]
            }
          },
          {
            "position": { "x": 1150, "y": 500 },
            "size": { "width": 200, "height": 140 },
            "attrs": { "text": { "text": "API ASP.NET Core" }, "body": { "stroke": "#d97706", "strokeWidth": 2, "strokeDasharray": null } },
            "shape": "process",
            "id": "00000000-0000-4000-8000-000000000004",
            "zIndex": 4,
            "data": {
              "name": "API ASP.NET Core",
              "description": "Valida contratos, autentica, autoriza, aplica regras, registra horários do servidor e coordena transações e auditoria.",
              "type": "tm.Process",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-07 — Erro, log ou telemetria expõe dados",
                  "type": "Information disclosure",
                  "description": "Stack trace, erro, log ou atributo de telemetria pode expor documento, token ou configuração.",
                  "mitigation": "Usar ProblemDetails seguro, logs mínimos, valores de query redigidos e OTLP opt-in. Collector e retenção ainda precisam de definição.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000007"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-08 — Consulta expõe histórico excessivo",
                  "type": "Information disclosure",
                  "description": "Consulta ou exportação pode revelar histórico além da necessidade funcional do perfil.",
                  "mitigation": "Aplicar menor privilégio, políticas por operação, paginação, limites temporais e respostas minimizadas. Auditoria de consultas depende de validação.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000008"
                },
                {
                  "status": "Mitigated",
                  "severity": "Medium",
                  "title": "TM-11 — Requisição esgota API ou banco",
                  "type": "Denial of service",
                  "description": "Payload grande, consulta cara ou volume elevado pode degradar o serviço.",
                  "mitigation": "Limite de 1 MiB, paginação, janelas máximas, índices e rate limiting por usuário ou endereço. Carga real e limite distribuído permanecem pendentes.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000011"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "TM-12 — Indisponibilidade interrompe a portaria",
                  "type": "Denial of service",
                  "description": "Falha de rede, API ou PostgreSQL pode impedir a operação da portaria.",
                  "mitigation": "Usar readiness, smoke tests, telemetria, backup e contingência reconciliável. Collector, alertas e procedimento institucional estão pendentes nas Issues #30 e #100.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000012"
                },
                {
                  "status": "Mitigated",
                  "severity": "High",
                  "title": "TM-13 — Elevação de privilégio por perfil",
                  "type": "Elevation of privilege",
                  "description": "Um usuário tenta executar operação administrativa ou acessar histórico incompatível com seu perfil.",
                  "mitigation": "Negar por padrão e aplicar políticas no servidor por recurso e operação. A matriz técnica está coberta por testes; a matriz institucional final ainda será homologada.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000013"
                },
                {
                  "status": "Mitigated",
                  "severity": "Medium",
                  "title": "TM-23 — Enumeração ou adulteração de vínculo recorrente",
                  "type": "Tampering / Information disclosure",
                  "description": "Uma busca irrestrita pode enumerar pessoas, ou um cliente adulterado pode enviar identificadores, placa e nome que não correspondem ao vínculo escolhido.",
                  "mitigation": "Restringir à política operacional, limitar termo e resultados, aplicar rate limiting, omitir documento, e-mail e histórico, e revalidar no servidor o par ativo usando seus valores canônicos. Integração visual e calibração institucional permanecem nas Issues #214 e #162.",
                  "modelType": "STRIDE",
                  "id": "10000000-0000-4000-8000-000000000023"
                }
              ]
            }
          },
